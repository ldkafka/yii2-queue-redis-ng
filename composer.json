{
    "name": "ldkafka/yii2-queue-redis-ng",
    "type": "yii2-extension",
    "description": "Redis driver for yii2-queue with job priority, atomic (crash-safe) reservation, configurable ordering of retried and delayed jobs, and optional aging against starvation. Drop-in replacement for the stock driver.",
    "keywords": [
        "yii2",
        "queue",
        "redis",
        "priority",
        "priority-queue",
        "yii2-queue",
        "delay",
        "retry",
        "aging",
        "lua"
    ],
    "homepage": "https://github.com/ldkafka/yii2-queue-redis-ng",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/ldkafka/yii2-queue-redis-ng/issues",
        "source": "https://github.com/ldkafka/yii2-queue-redis-ng"
    },
    "authors": [
        {
            "name": "ldkafka",
            "homepage": "https://github.com/ldkafka"
        }
    ],
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "~2.0.14",
        "yiisoft/yii2-queue": "^2.3.7",
        "yiisoft/yii2-redis": "~2.0.0 || ~2.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ldkafka\\queue\\redis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ldkafka\\queue\\redis\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
